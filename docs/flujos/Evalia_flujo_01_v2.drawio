idad por diseño&lt;/b&gt;&lt;br&gt;minimización · sin uso comercial · retención" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontColor=#2D3748;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="1372" width="275" height="90" as="geometry"/></mxCell><mxCell id="p1-gv3" value="&lt;b&gt;Auditoría y versionado&lt;/b&gt;&lt;br&gt;quién cambió qué · versión curricular" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontColor=#2D3748;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1065" y="1372" width="275" height="90" as="geometry"/></mxCell><mxCell id="p1-gv4" value="&lt;b&gt;Accesibilidad&lt;/b&gt;&lt;br&gt;WCAG 2.2 AA · lectura en voz · tiempo extra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontColor=#2D3748;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1350" y="1372" width="275" height="90" as="geometry"/></mxCell><mxCell id="p1-gv5" value="&lt;b&gt;Supervisión humana&lt;/b&gt;&lt;br&gt;la IA sugiere, el docente decide" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontColor=#2D3748;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1635" y="1372" width="275" height="90" as="geometry"/></mxCell><mxCell id="p1-gv6" value="&lt;b&gt;Normativa de evaluación&lt;/b&gt;&lt;br&gt;CL: Decreto 67/2018&lt;br&gt;CR: REAC Decreto 45509-MEP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF2F7;strokeColor=#A0AEC0;fontColor=#2D3748;fontSize=11;align=center;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1920" y="1372" width="275" height="90" as="geometry"/></mxCell><mxCell id="p1-gv7" 