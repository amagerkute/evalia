ell id="p4-e20" value="solo cerradas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2F855A;strokeWidth=2;fontSize=10;fontColor=#2F855A;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;" edge="1" parent="1" source="p4-auto" target="p4-graded"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="590"/><mxPoint x="1590" y="590"/></Array></mxGeometry></mxCell><mxCell id="p4-inv" value="&lt;b&gt;INVARIANTES&lt;/b&gt;&lt;br&gt;• Un intento siempre apunta a una versión publicada exacta.&lt;br&gt;• Ninguna nota de pregunta abierta pasa a 'Calificado' sin acción docente.&lt;br&gt;• Cerrar la evaluación cierra intentos en curso como 'Enviado' con marca de tiempo.&lt;br&gt;• Cada transición genera un registro de auditoría (actor, fecha, motivo)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#A0AEC0;fontColor=#2D3748;fontSize=13;align=left;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="1100" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
