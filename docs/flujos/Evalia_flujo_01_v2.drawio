olor=#102A43;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="125" width="1060" height="36" as="geometry"/></mxCell><mxCell id="p2-fw" value="&lt;div style='background:#2B6CB0;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;CurriculumFramework · Marco&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;id*, country* (CL|CR), authority* (MINEDUC|MEP)&lt;br&gt;name* (p.ej. Bases Curriculares 7°–2°M)&lt;br&gt;legal_ref (decreto / acuerdo CSE)&lt;br&gt;version*, valid_from*, valid_to&lt;br&gt;status: vigente | en_transición | derogado&lt;br&gt;source_url*, source_hash, retrieved_at&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="175" width="330" height="165" as="geometry"/></mxCell><mxCell id="p2-pathway" value="&lt;div style='background:#2B6CB0;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;Pathway · Oferta / modalidad&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;id*, framework_id*&lt;br&gt;name* (CL: HC, TP, Artística, EPJA…&lt;br&gt;CR: Académica, Técnica, CINDEA, IPEC…)&lt;br&gt;schedule (diurna / nocturna)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="360" width="330" height="110" as="geometry"/></mxCell><mxCell id="p2-stage" value="&lt;div style='background:#2B6CB0;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;Stage · Tramo / ciclo&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;id*, pathway_id*, name*&lt;br&gt;CL: Parvularia, Básica, Media&lt;br&gt;CR: Preescolar, I–II–III Ciclo, Diversificada&lt;br&gt;order*&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="330" height="110" as="geometry"/></mxCell><mxCell id="p2-grade" value="&lt;div style='background:#2B6CB0;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;Grade · Curso / año / nivel&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;id*, stage_id*, label* (4° básico · 4.° año)&lt;br&gt;order*, typical_age&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="620" width="330" height="80" as="geometry"/></mxCell><mxCell id="p2-subject" value="&lt;div style='background:#2B6CB0;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;Subject · Asignatura / área&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;id*, framework_id*, code (CL: MA, LE…)&lt;br&gt;name*, grades[]&lt;br&gt;program_ref* (programa de estudio + año)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="390" y="175" width="320" height="110" as="geometry"/></mxCell><mxCell id="p2-group" value="&lt;div style='background:#2B6CB0;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;CurriculumGroup · Agrupador&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;id*, subject_id*, grade_id*, parent_id&lt;br&gt;kind*: eje | unidad | área | tema | eje_temático | módulo&lt;br&gt;code, name*, order&lt;br&gt;(jerarquía libre: CR puede tener 2–3 niveles)&lt;/div&gt;" style="rounded=0;w