*, kind*: conocimiento | habilidad | actitud | proceso&lt;br&gt;text*, taxonomy (Bloom / DOK)&lt;br&gt;N:M con LearningObjective&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="295" width="320" height="100" as="geometry"/></mxCell><mxCell id="p2-rel" value="&lt;div style='background:#2B6CB0;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;ObjectiveRelation&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;from_id*, to_id*&lt;br&gt;type*: prerrequisito | progresión | relacionado&lt;br&gt;cross-country solo como 'relacionado',&lt;br&gt;curado por humano, con justificación&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="415" width="320" height="115" as="geometry"/></mxCell><mxCell id="p2-prov" value="&lt;div style='background:#6B46C1;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;CurriculumProvider · Origen de datos&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;id*, kind*: evalia_catalog | external_api | manual_upload&lt;br&gt;name (p.ej. plataforma de Orlando)&lt;br&gt;contract_version*, sync_mode (pull / webhook)&lt;br&gt;last_sync_at, license / términos&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B46C1;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="740" y="550" width="320" height="120" as="geometry"/></mxCell><mxCell id="p2-zone2" value="DISEÑO DE LA EVALUACIÓN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#805AD5;fontColor=#102A43;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="125" width="560" height="36" as="geometry"/></mxCell><mxCell id="p2-ctx" value="&lt;div style='background:#6B46C1;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;Organization · Course · Enrollment&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;Organization: país, RBD / código MEP, políticas&lt;br&gt;Course: org_id, grade_id, subject_id, year&lt;br&gt;Enrollment: student_id, course_id, apoyos&lt;br&gt;Guardianship: guardian_id, student_id, consent_id&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B46C1;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="175" width="540" height="105" as="geometry"/></mxCell><mxCell id="p2-assess" value="&lt;div style='background:#6B46C1;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;Assessment · Evaluación&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;id*, course_id*, author_id*, framework_version*&lt;br&gt;purpose*: diagnóstica | formativa | sumativa&lt;br&gt;scale* (CL 1,0–7,0 + exigencia % · CR 1–100), time_limit&lt;br&gt;status* (ver página 04), version*, published_hash&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B46C1;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="300" width="540" height="110" as="geometry"/></mxCell><mxCell id="p2-bp" value="&lt;div style='background:#6B46C1;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;BlueprintRow · Tabla de especificaciones&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;assessment_id*, objective_id*, indicator_ids[]&lt;br&gt;cognitive_level (Bloom / DOK), weight %, n_items&lt;br&gt;item_types[], accommodations&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B46C1;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="430" width="540" height="90" as="geometry"/></mxCell><mxCell id="p2-item" value="&lt;div style='background:#6B46C1;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;Item · Ítem&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;id*, assessment_id*, type* (única | múltiple | abierta | …)&lt;br&gt;stem*, options[], key, rubric_id, points&lt;br&gt;objective_ids[]* (N:M), indicator_ids[], source_refs[]&lt;br&gt;generated_by (IA | docente), edited, approved_by*&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B46C1;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="540" width="540" height="110" as="geometry"/></mxCell><mxCell id="p2-hint" value="&lt;div style='background:#6B46C1;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;HelpPolicy · Política del tutor&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;item_id*, enabled*, max_level* (0–3)&lt;br&gt;0 sin ayuda · 1 preguntas guía · 2 pistas · 3 ejemplo parcial&lt;br&gt;allowed_materials[], forbidden: revelar respuesta*&lt;br&gt;score_effect: ninguno | informativo | ponderado&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B46C1;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1120" y="670" width="540" height="110" as="geometry"/></mxCell><mxCell id="p2-zone3" value="EJECUCIÓN Y RESULTADOS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#38A169;fontColor=#102A43;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="125" width="560" height="36" as="geometry"/></mxCell><mxCell id="p2-att" value="&lt;div style='background:#2F855A;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;Attempt · Intento&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;id*, assessment_version*, student_id*&lt;br&gt;started_at, submitted_at, status*, accommodations_applied&lt;br&gt;consent_snapshot_id*&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F855A;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1710" y="175" width="540" height="90" as="geometry"/></mxCell><mxCell id="p2-resp" value="&lt;div style='background:#2F855A;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;Response · Respuesta&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;attempt_id*, item_id*, answer, justification&lt;br&gt;confidence (1–4), time_spent, revisions&lt;br&gt;auto_score, suggested_score + confidence, final_score*, graded_by*&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F855A;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1710" y="285" width="540" height="95" as="geometry"/></mxCell><mxCell id="p2-evt" value="&lt;div style='background:#2F855A;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;TutorEvent · Evento del tutor&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;attempt_id*, item_id*, ts*, role (estudiante | tutor)&lt;br&gt;help_level_used, message (retención limitada)&lt;br&gt;detected_misconception, policy_violation_flag&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F855A;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1710" y="400" width="540" height="95" as="geometry"/></mxCell><mxCell id="p2-mast" value="&lt;div style='background:#2F855A;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;ObjectiveMastery · Logro por objetivo&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;student_id*, objective_id*, assessment_id*&lt;br&gt;level (inicial | intermedio | adecuado | avanzado)&lt;br&gt;evidence_count, help_dependency %&lt;br&gt;visible_to: docente, estudiante, responsable (resumen)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F855A;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1710" y="515" width="540" height="110" as="geometry"/></mxCell><mxCell id="p2-audit" value="&lt;div style='background:#4A5568;color:#fff;padding:6px 8px;font-weight:bold;font-size:13px'&gt;AuditLog · Consent&lt;/div&gt;&lt;div style='padding:6px 10px;text-align:left;font-size:11px;line-height:1.45'&gt;AuditLog: actor, acción, entidad, antes/después, ts&lt;br&gt;Consent: sujeto, otorgante, alcance, base legal,&lt;br&gt;   evidencia, otorgado_at, revocado_at&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5568;strokeWidth=2;verticalAlign=top;align=left;spacing=0;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1710" y="645" width="540" height="95" as="geometry"/></mxCell><mxCell id="p2-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#718096;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="p2-fw" target="p2-pathway"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#718096;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="p2-pathway" target="p2-stage"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#718096;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="p2-stage" target="p2-grade"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#718096;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="p2-fw" target="p2-subject"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#718096;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="p2-subject" target="p2-group"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#718096;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="p2-group" target="p2-obj"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#718096;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="p2-obj" target="p2-ind"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#718096;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="p2-assess" target="p2-bp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#718096;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="p2-assess" target="p2-item"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#718096;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="p2-item" target="p2-hint"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#718096;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="p2-att" target="p2-resp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmany;startArrow=ERmandOne;strokeColor=#718096;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="p2-att" target="p2-evt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e13" value="N:M" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERmany;strokeColor=#718096;fontFamily=Helvetica;" edge="1" parent="1" source="p2-obj" target="p2-tag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e14" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERmany;strokeColor=#718096;dashed=1;fontFamily=Helvetica;" edge="1" parent="1" source="p2-obj" target="p2-rel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e15" value="alimenta" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6B46C1;dashed=1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="p2-prov" target="p2-fw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="610"/><mxPoint x="1080" y="150"/><mxPoint x="195" y="150"/></Array></mxGeometry></mxCell><mxCell id="p2-e16" value="objective_id" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#6B46C1;fontSize=10;fontFamily=Helvetica;" edge="1" parent="1" source="p2-bp" target="p2-obj"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e17" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2F855A;fontFamily=Helvetica;" edge="1" parent="1" source="p2-resp" target="p2-item"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p2-e18" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2F855A;dashed=1;fontFamily=Helvetica;" edge="1" parent="1" source="p2-mast" target="p2-obj"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1690" y="570"/><mxPoint x="1690" y="800"/><mxPoint x="550" y="800"/><mxPoint x="550" y="635"/></Array></mxGeometry></mxCell><mxCell id="p2-map" value="&lt;b style='font-size:14px'&gt;ADAPTADORES · cómo se instancia cada campo por país&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style='border-collapse:collapse;width:100%;font-size:11px' border='1' cellpadding='5'&gt;
&lt;tr style='background:#102A43;color:#fff'&gt;&lt;th&gt;Campo canónico&lt;/th&gt;&lt;th&gt;Chile · MINEDUC&lt;/th&gt;&lt;th&gt;Costa Rica · MEP&lt;/th&gt;&lt;th&gt;Estado&lt;/th&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;b&gt;CurriculumFramework&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Bases Curriculares: Parvularia (2018), 1°–6° básico (2012), 7°–2° medio (2015), 3°–4° medio (2019). Priorización curricular vigente como capa adicional. Actualización 1°B–2°M en trámite.&lt;/td&gt;&lt;td&gt;Programas de estudio por asignatura y ciclo (fechas distintas por programa, p.ej. Matemáticas 2012; “Educar para una nueva ciudadanía” 2016+). Marcos de especificaciones de Pruebas Nacionales (DGEC 2026).&lt;/td&gt;&lt;td&gt;Validar vigencias&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;b&gt;Pathway&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Regular (HC / TP / Artística en 3°–4° medio), EPJA, Especial&lt;/td&gt;&lt;td&gt;Académica, Técnica, Artística, CINDEA / IPEC, Nocturna, Especial, Indígena&lt;/td&gt;&lt;td&gt;Validar lista&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;b&gt;Stage → Grade&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Parvularia (Sala Cuna, Medio, Transición) · Básica 1°–8° · Media 1°–4°&lt;/td&gt;&lt;td&gt;Preescolar (Interactivo II, Transición) · I Ciclo 1°–3° · II Ciclo 4°–6° · III Ciclo 7°–9° · Diversificada 10°–11° (12° técnica)&lt;/td&gt;&lt;td&gt;Estable&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;b&gt;CurriculumGroup&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Eje (Matemática: Números y operaciones, Patrones y álgebra, Geometría, Medición, Datos y probabilidades) · Unidad del programa&lt;/td&gt;&lt;td&gt;Área (Matemáticas: Números, Geometría, Medidas, Relaciones y álgebra, Estadística y probabilidad) · unidad · eje temático (varía por programa)&lt;/td&gt;&lt;td&gt;Por programa&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;b&gt;LearningObjective.kind&lt;/b&gt;&lt;/td&gt;&lt;td&gt;OA (código oficial tipo MA04 OA 03) · OAT · OA de habilidades y actitudes&lt;/td&gt;&lt;td&gt;Habilidad específica (Mate) · aprendizaje esperado · criterio de evaluación · saber / contenido (según programa)&lt;/td&gt;&lt;td&gt;CR: inventariar por programa&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;b&gt;Indicator&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Indicadores de evaluación sugeridos en Programas de Estudio (complementables)&lt;/td&gt;&lt;td&gt;Indicaciones puntuales (Mate) · indicadores del aprendizaje esperado (planeamiento) · criterios&lt;/td&gt;&lt;td&gt;Origen marcado&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;b&gt;Assessment.scale&lt;/b&gt;&lt;/td&gt;&lt;td&gt;1,0–7,0 · aprobación 4,0 · exigencia definida por reglamento del centro (Decreto 67/2018)&lt;/td&gt;&lt;td&gt;1–100 · REAC 2026 (Decreto 45509-MEP): nota mínima reportada 75; componentes y porcentajes por ciclo&lt;/td&gt;&lt;td&gt;Validar con texto oficial&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;b&gt;Accommodations&lt;/b&gt;&lt;/td&gt;&lt;td&gt;DUA / diversificación (Decreto 83/2015) · PIE (Decreto 170)&lt;/td&gt;&lt;td&gt;Apoyos educativos: de acceso, curriculares no significativos / significativos&lt;/td&gt;&lt;td&gt;Validar términos&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;b&gt;Organization id&lt;/b&gt;&lt;/td&gt;&lt;td&gt;RBD&lt;/td&gt;&lt;td&gt;Código presupuestario del centro educativo&lt;/td&gt;&lt;td&gt;Estable&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td&gt;&lt;b&gt;Responsable&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Apoderado/a&lt;/td&gt;&lt;td&gt;Persona encargada legal / encargado de familia&lt;/td&gt;&lt;td&gt;UI localizada&lt;/td&gt;&lt;/tr&gt;
&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB3C8;verticalAlign=top;align=left;spacing=10;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="1500" height="400" as="geometry"/></mxCell><mxCell id="p2-rules" value="&lt;b&gt;REGLAS DEL MODELO&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. El texto oficial del objetivo se almacena literal y con fuente; la IA puede &lt;i&gt;parafrasear para estudiantes&lt;/i&gt; en un campo aparte.&lt;br&gt;&lt;br&gt;2. Toda evaluación publicada queda anclada a una &lt;b&gt;versión&lt;/b&gt; del marco; un cambio curricular no altera evaluaciones históricas.&lt;br&gt;&lt;br&gt;3. Un ítem puede cubrir varios objetivos (N:M), pero el blueprint pondera cada uno.&lt;br&gt;&lt;br&gt;4. Los indicadores tienen origen trazable (oficial / docente / IA aprobada por docente).&lt;br&gt;&lt;br&gt;5. Las equivalencias CL↔CR solo existen como relación 'relacionado', curada por humanos. Nunca para calificar.&lt;br&gt;&lt;br&gt;6. El proveedor curricular es intercambiable: Evalia consume una interfaz, no una base concreta. Eso permite integrar la plataforma de Orlando sin acoplarnos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#63B3ED;fontColor=#1A365D;fontSize=12;align=left;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;verticalAlign=top;dashed=1;" vertex="1" parent="1"><mxGeometry x="1540" y="830" width="720" height="400" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p3" name="03 · Visibilidad por rol"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p3-title" value="MATRIZ DE VISIBILIDAD Y PERMISOS · propuesta inicial (por defecto; el centro puede restringir, nunca ampliar sobre lo legal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102A43;strokeColor=#102A43;fontColor=#FFFFFF;fontSize=22;align=left;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1860" height="60" as="geometry"/></mxCell><mxCell id="p3-matrix" value="&lt;table border='1' cellpadding='7' style='border-collapse:collapse;width:100%;font-size:12px'&gt;&lt;tr style='background:#D9E2EC'&gt;&lt;th&gt;Dato / acción&lt;/th&gt;&lt;th&gt;Centro educativo&lt;/th&gt;&lt;th&gt;Docente&lt;/th&gt;&lt;th&gt;Tutor independiente&lt;/th&gt;&lt;th&gt;Estudiante&lt;/th&gt;&lt;th&gt;Apoderado / responsable&lt;/th&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF'&gt;&lt;td&gt;&lt;b&gt;Catálogo curricular (marcos, objetivos, indicadores)&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;Parafraseado&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#B7791F'&gt;Resumen&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#F7FAFC'&gt;&lt;td&gt;&lt;b&gt;Crear / editar evaluaciones y blueprint&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;Plantillas&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt; (sus cursos)&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt; (sus grupos)&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF'&gt;&lt;td&gt;&lt;b&gt;Aprobar / publicar evaluación&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;V°B° opcional&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#F7FAFC'&gt;&lt;td&gt;&lt;b&gt;Política de ayuda del tutor&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;Define máximos&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt; (≤ máximo)&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;Ve la vigente&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF'&gt;&lt;td&gt;&lt;b&gt;Respuestas individuales&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#6B46C1'&gt;Con permiso&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;Las propias&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#F7FAFC'&gt;&lt;td&gt;&lt;b&gt;Conversación completa con el tutor&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;La propia&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#6B46C1'&gt;Con permiso&lt;/span&gt; (explícito y registrado)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF'&gt;&lt;td&gt;&lt;b&gt;Puntaje / nota individual&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt; (sus cursos)&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;La propia&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt; (su pupilo)&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#F7FAFC'&gt;&lt;td&gt;&lt;b&gt;Logro por objetivo&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2B6CB0'&gt;Agregado&lt;/span&gt; + individual&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;El propio&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#B7791F'&gt;Resumen&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF'&gt;&lt;td&gt;&lt;b&gt;Dependencia de ayuda / errores frecuentes&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2B6CB0'&gt;Agregado&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;El propio (formulado en positivo)&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#B7791F'&gt;Resumen&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#F7FAFC'&gt;&lt;td&gt;&lt;b&gt;Datos personales y matrícula&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;Sus estudiantes&lt;/td&gt;&lt;td style='text-align:center'&gt;Sus estudiantes&lt;/td&gt;&lt;td style='text-align:center'&gt;Los propios&lt;/td&gt;&lt;td style='text-align:center'&gt;Su pupilo&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF'&gt;&lt;td&gt;&lt;b&gt;Consentimientos&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;Estado (sí/no)&lt;/td&gt;&lt;td style='text-align:center'&gt;Estado (sí/no)&lt;/td&gt;&lt;td style='text-align:center'&gt;Los propios&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt; otorga / revoca&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#F7FAFC'&gt;&lt;td&gt;&lt;b&gt;Exportación de datos&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;Sus cursos&lt;/td&gt;&lt;td style='text-align:center'&gt;Sus grupos&lt;/td&gt;&lt;td style='text-align:center'&gt;Descarga propia&lt;/td&gt;&lt;td style='text-align:center'&gt;Descarga de su pupilo&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFFFFF'&gt;&lt;td&gt;&lt;b&gt;Datos para investigación&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;Anonimizados + convenio&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#F7FAFC'&gt;&lt;td&gt;&lt;b&gt;Registro de auditoría&lt;/b&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#2F855A'&gt;&lt;b&gt;✔&lt;/b&gt;&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;Sus acciones&lt;/td&gt;&lt;td style='text-align:center'&gt;Sus acciones&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;td style='text-align:center'&gt;&lt;span style='color:#C53030'&gt;✖&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB3C8;verticalAlign=top;align=left;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1860" height="440" as="geometry"/></mxCell><mxCell id="p3-notes" value="&lt;b&gt;PREGUNTAS ABIERTAS PARA LA MESA&lt;/b&gt;&lt;br&gt;&lt;br&gt;• ¿El responsable puede ver conversaciones? Propuesta: no por defecto; solo con consentimiento del estudiante (según edad) y política del centro.&lt;br&gt;• Estudiantes ≥ 14 (CL: adolescentes en Ley 21.719) ¿consienten parte del tratamiento por sí mismos? Validar con asesoría legal CL y CR.&lt;br&gt;• ¿El centro ve conversaciones individuales? Propuesta: solo ante protocolo (convivencia / protección), con registro de auditoría.&lt;br&gt;• Tutor independiente con estudiantes menores: exige vinculación y consentimiento del responsable antes del primer intento.&lt;br&gt;• ¿Cuánto tiempo se retienen las conversaciones? Propuesta inicial: fin del año escolar + 1 año, salvo exportación o caso de estudio anonimizado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#ED8936;fontColor=#7B341E;fontSize=13;align=left;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="560" width="1860" height="180" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p4" name="04 · Estados de evaluación e intento"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p4-title" value="CICLO DE VIDA · estados de la evaluación y del intento del estudiante" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102A43;strokeColor=#102A43;fontColor=#FFFFFF;fontSize=22;align=left;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1960" height="60" as="geometry"/></mxCell><mxCell id="p4-lbl1" value="&lt;b&gt;EVALUACIÓN&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#102A43;fontSize=15;align=left;verticalAlign=middle;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="150" height="40" as="geometry"/></mxCell><mxCell id="p4-draft" value="Borrador" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#EDF2F7;strokeColor=#486581;strokeWidth=1.5;fontSize=12;fontColor=#102A43;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="165" height="70" as="geometry"/></mxCell><mxCell id="p4-review" value="En revisión docente" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FEFCBF;strokeColor=#486581;strokeWidth=1.5;fontSize=12;fontColor=#102A43;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="225" y="170" width="165" height="70" as="geometry"/></mxCell><mxCell id="p4-coord" value="V°B° coordinación&lt;br&gt;(opcional)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FEFCBF;strokeColor=#486581;strokeWidth=1.5;fontSize=12;fontColor=#102A43;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="420" y="170" width="165" height="70" as="geometry"/></mxCell><mxCell id="p4-approved" value="Aprobada" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#E6FFFA;strokeColor=#486581;strokeWidth=1.5;fontSize=12;fontColor=#102A43;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="615" y="170" width="165" height="70" as="geometry"/></mxCell><mxCell id="p4-published" value="Publicada&lt;br&gt;(versión inmutable)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#C6F6D5;strokeColor=#486581;strokeWidth=1.5;fontSize=12;fontColor=#102A43;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="810" y="170" width="165" height="70" as="geometry"/></mxCell><mxCell id="p4-open" value="Abierta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#C6F6D5;strokeColor=#486581;strokeWidth=1.5;fontSize=12;fontColor=#102A43;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1005" y="170" width="165" height="70" as="geometry"/></mxCell><mxCell id="p4-closed" value="Cerrada" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#E2E8F0;strokeColor=#486581;strokeWidth=1.5;fontSize=12;fontColor=#102A43;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1200" y="170" width="165" height="70" as="geometry"/></mxCell><mxCell id="p4-grading" value="En corrección" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#FEEBC8;strokeColor=#486581;strokeWidth=1.5;fontSize=12;fontColor=#102A43;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1395" y="170" width="165" height="70" as="geometry"/></mxCell><mxCell id="p4-released" value="Resultados liberados" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#BEE3F8;strokeColor=#486581;strokeWidth=1.5;fontSize=12;fontColor=#102A43;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1590" y="170" width="165" height="70" as="geometry"/></mxCell><mxCell id="p4-archived" value