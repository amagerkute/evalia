<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="p1" name="01 · Flujo por rol (swimlanes)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1557" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-title" value="EVALIA · FLUJO 01 — Evaluación alineada al currículo oficial (Chile · Costa Rica)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102A43;strokeColor=#102A43;fontColor=#FFFFFF;fontSize=24;align=left;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="2490" height="60" as="geometry"/></mxCell><mxCell id="p1-sub" value="Del contexto institucional al ciclo de mejora. Cada paso numerado es una historia de usuario candidata; los procesos con doble borde son servicios de Evalia. v2 · 28-09-2026 · Documento de trabajo para validar con Leo, Rob y José." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#486581;fontSize=13;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="84" width="2470" height="30" as="geometry"/></mxCell><mxCell id="p1-ph0" value="A · Alta y acceso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#9FB3C8;fontColor=#102A43;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210" y="125" width="275" height="36" as="geometry"/></mxCell><mxCell id="p1-ph1" value="B · Curso y ruta curricular" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#9FB3C8;fontColor=#102A43;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="495" y="125" width="275" height="36" as="geometry"/></mxCell><mxCell id="p1-ph2" value="C · Diseño (blueprint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#9FB3C8;fontColor=#102A43;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="780" y="125" width="275" height="36" as="geometry"/></mxCell><mxCell id="p1-ph3" value="D · Generación y revisión" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#9FB3C8;fontColor=#102A43;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1065" y="125" width="275" height="36" as="geometry"/></mxCell><mxCell id="p1-ph4" value="E · Aprobación y publicación" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#9FB3C8;fontColor=#102A43;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1350" y="125" width="275" height="36" as="geometry"/></mxCell><mxCell id="p1-ph5" value="F · Aplicación con tutor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#9FB3C8;fontColor=#102A43;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1635" y="125" width="275" height="36" as="geometry"/></mxCell><mxCell id="p1-ph6" value="G · Corrección y feedback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#9FB3C8;fontColor=#102A43;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1920" y="125" width="275" height="36" as="geometry"/></mxCell><mxCell id="p1-ph7" value="H · Análisis y mejora" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9E2EC;strokeColor=#9FB3C8;fontColor=#102A43;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2205" y="125" width="275" height="36" as="geometry"/></mxCell><mxCell id="p1-lane_centro" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F0F7FF;strokeColor=#3E7CB1;fontColor=#102A43;fontSize=12;align=left;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;opacity=100;" vertex="1" parent="1"><mxGeometry x="20" y="171" width="2490" height="215" as="geometry"/></mxCell><mxCell id="p1-lbl_centro" value="CENTRO EDUCATIVO&lt;br&gt;&lt;font style='font-size:10px'&gt;Dirección · UTP / Coordinación académica · Admin&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#3E7CB1;strokeColor=#3E7CB1;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="171" width="180" height="215" as="geometry"/></mxCell><mxCell id="p1-lane_docente" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3F0FF;strokeColor=#805AD5;fontColor=#102A43;fontSize=12;align=left;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;opacity=100;" vertex="1" parent="1"><mxGeometry x="20" y="394" width="2490" height="300" as="geometry"/></mxCell><mxCell id="p1-lbl_docente" value="DOCENTE / TUTOR&lt;br&gt;&lt;font style='font-size:10px'&gt;Docente de aula · tutor independiente&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#805AD5;strokeColor=#805AD5;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="394" width="180" height="300" as="geometry"/></mxCell><mxCell id="p1-lane_sys" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#4A5568;fontColor=#102A43;fontSize=12;align=left;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;opacity=100;" vertex="1" parent="1"><mxGeometry x="20" y="702" width="2490" height="250" as="geometry"/></mxCell><mxCell id="p1-lbl_sys" value="SERVICIOS EVALIA&lt;br&gt;&lt;font style='font-size:10px'&gt;Catálogo curricular · IA · reglas · analítica&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4A5568;strokeColor=#4A5568;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="702" width="180" height="250" as="geometry"/></mxCell><mxCell id="p1-lane_est" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ECFDF3;strokeColor=#38A169;fontColor=#102A43;fontSize=12;align=left;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;opacity=100;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="2490" height="215" as="geometry"/></mxCell><mxCell id="p1-lbl_est" value="ESTUDIANTE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#38A169;strokeColor=#38A169;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="960" width="180" height="215" as="geometry"/></mxCell><mxCell id="p1-lane_apod" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#D69E2E;fontColor=#102A43;fontSize=12;align=left;verticalAlign=middle;arcSize=6;spacing=8;fontFamily=Helvetica;opacity=100;" vertex="1" parent="1"><mxGeometry x="20" y="1183" width="2490" height="175" as="geometry"/></mxCell><mxCell id="p1-lbl_apod" value="APODERADO / PERSONA ENCARGADA&lt;br&gt;&lt;font style='font-size:10px'&gt;CL: apoderado · CR: persona encargada legal&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D69E2E;strokeColor=#D69E2E;fontColor=#FFFFFF;fontSize=13;align=center;verticalAlign=middle;fontStyle=1;arcSize=6;spacing=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="1183" width="180" height="175" as="geometry"/></mxCell><mxCell id="p1-C1" value="&lt;b&gt;C1 · Alta del centro&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;País · RBD (CL) / código MEP (CR)&lt;br&gt;Dependencia · modalidad · jornada&lt;br&gt;Calendario escolar y periodos&lt;br&gt;Plan de estudios adoptado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E7CB1;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="218" y="183" width="259" height="120" as="geometry"/></mxCell><mxCell id="p1-C2" value="&lt;b&gt;C2 · Estructura académica&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Cursos / secciones y jefaturas&lt;br&gt;Carga de docentes y matrícula (CSV / SSO)&lt;br&gt;Vínculo estudiante ↔ responsable&lt;br&gt;Apoyos: PIE (CL) · apoyos educativos (CR)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E7CB1;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="503" y="183" width="259" height="130" as="geometry"/></mxCell><mxCell id="p1-C3" value="&lt;b&gt;C3 · Políticas institucionales&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Uso permitido de IA y nivel de ayuda máximo&lt;br&gt;Escala: CL 1,0–7,0 · CR 1–100&lt;br&gt;Retención de datos y consentimiento&lt;br&gt;¿Exige V°B° de coordinación?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E7CB1;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="788" y="183" width="259" height="130" as="geometry"/></mxCell><mxCell id="p1-C4" value="&lt;b&gt;C4 · V°B° de coordinación (opcional)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;UTP / coordinación revisa cobertura&lt;br&gt;y calidad antes de publicar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E7CB1;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="1358" y="183" width="259" height="85" as="geometry"/></mxCell><mxCell id="p1-C5" value="&lt;b&gt;C5 · Tablero institucional&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Cobertura curricular por curso&lt;br&gt;Logro agregado por objetivo y cohorte&lt;br&gt;Alertas pedagógicas (no punitivas)&lt;br&gt;Sin decisiones automáticas de alto impacto&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E7CB1;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2213" y="183" width="259" height="130" as="geometry"/></mxCell><mxCell id="p1-D0" value="&lt;b&gt;D0 · Cuenta docente o tutor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;&lt;b&gt;Con centro:&lt;/b&gt; invitado, hereda contexto&lt;br&gt;&lt;b&gt;Independiente:&lt;/b&gt; declara país,&lt;br&gt;nivel y crea su propio grupo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="218" y="406" width="259" height="110" as="geometry"/></mxCell><mxCell id="p1-D1" value="&lt;b&gt;D1 · Elegir curso y ruta curricular&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Curso → asignatura (hereda país, nivel y marco vigente)&lt;br&gt;Unidad / eje / área&lt;br&gt;Selecciona objetivos: OA · habilidades específicas · aprendizajes esperados&lt;br&gt;Ve indicadores oficiales y puede agregar propios&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="503" y="406" width="259" height="150" as="geometry"/></mxCell><mxCell id="p1-D2" value="&lt;b&gt;D2 · Blueprint (tabla de especificaciones)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Propósito: diagnóstica · formativa · sumativa&lt;br&gt;Objetivo × habilidad cognitiva × peso × n° ítems&lt;br&gt;Tipos de ítem, tiempo, escala y exigencia&lt;br&gt;Adecuaciones: DUA / apoyos&lt;br&gt;Material propio opcional + fuentes&lt;br&gt;Política de ayuda por defecto&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="788" y="406" width="259" height="170" as="geometry"/></mxCell><mxCell id="p1-D3" value="&lt;b&gt;D3 · Revisar borrador ítem a ítem&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Editar · regenerar · reordenar · eliminar&lt;br&gt;Ver trazabilidad ítem ↔ objetivo ↔ fuente&lt;br&gt;Ajustar ayuda del tutor por ítem (0–3)&lt;br&gt;Previsualizar como estudiante&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1073" y="406" width="259" height="140" as="geometry"/></mxCell><mxCell id="p1-G1" value="G1 · ¿Alineada,&lt;br&gt;de calidad, accesible&lt;br&gt;y con ayuda segura?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;strokeWidth=2;fontColor=#744210;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1388" y="414" width="190" height="150" as="geometry"/></mxCell><mxCell id="p1-D5" value="&lt;b&gt;D5 · Monitoreo en vivo (opcional)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Progreso por estudiante&lt;br&gt;Alertas: bloqueo, uso intensivo de ayuda&lt;br&gt;Extender tiempo / pausar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="1643" y="406" width="259" height="110" as="geometry"/></mxCell><mxCell id="p1-D6" value="&lt;b&gt;D6 · Validar corrección&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Confirma o ajusta puntajes sugeridos&lt;br&gt;Revisa abiertas con rúbrica&lt;br&gt;Escribe/edita feedback&lt;br&gt;Libera resultados&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1928" y="406" width="259" height="130" as="geometry"/></mxCell><mxCell id="p1-D7" value="&lt;b&gt;D7 · Analizar y decidir&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Logro por objetivo e indicador&lt;br&gt;Razonamiento y errores frecuentes&lt;br&gt;Dependencia de ayuda&lt;br&gt;Reenseñanza · refuerzo · nueva evaluación&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2213" y="406" width="259" height="130" as="geometry"/></mxCell><mxCell id="p1-S1" value="&lt;b&gt;S1 · Catálogo curricular versionado&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Modelo canónico + adaptador CL / CR&lt;br&gt;Proveedor: propio · API externa · carga manual&lt;br&gt;Versión, vigencia y fuente oficial&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.04;fillColor=#FFFFFF;strokeColor=#4A5568;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="503" y="714" width="259" height="120" as="geometry"/></mxCell><mxCell id="p1-S2" value="&lt;b&gt;S2 · Asistente de blueprint&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Sugiere distribución y n° de ítems&lt;br&gt;Valida cobertura vs. tiempo disponible&lt;br&gt;Advierte objetivos no evaluables con el formato&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.04;fillColor=#FFFFFF;strokeColor=#4A5568;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="788" y="714" width="259" height="120" as="geometry"/></mxCell><mxCell id="p1-S3" value="&lt;b&gt;S3 · Generación IA + validaciones&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Ítems, claves, distractores con error esperado&lt;br&gt;Rúbrica, feedback previsto, guion de ayuda&lt;br&gt;Chequeos: alineación, lectura por edad, sesgo,&lt;br&gt;accesibilidad, duplicados, ayuda que no revela&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.04;fillColor=#FFFFFF;strokeColor=#4A5568;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1073" y="714" width="259" height="150" as="geometry"/></mxCell><mxCell id="p1-S4" value="&lt;b&gt;S4 · Publicación&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Versión inmutable (hash)&lt;br&gt;Asignación a curso / estudiantes&lt;br&gt;Link · QR · código de curso&lt;br&gt;Notificaciones&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.04;fillColor=#FFFFFF;strokeColor=#4A5568;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1358" y="714" width="259" height="130" as="geometry"/></mxCell><mxCell id="p1-S5" value="&lt;b&gt;S5 · Orquestador del tutor socrático&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Aplica política del ítem&lt;br&gt;Pregunta → pista gradual → comprobación&lt;br&gt;Registra cada evento de ayuda&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.04;fillColor=#FFFFFF;strokeColor=#4A5568;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1643" y="714" width="259" height="120" as="geometry"/></mxCell><mxCell id="p1-S6" value="&lt;b&gt;S6 · Corrección asistida&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Cerradas: automática&lt;br&gt;Abiertas: sugerencia con rúbrica + confianza&lt;br&gt;Nunca publica nota abierta sin docente&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.04;fillColor=#FFFFFF;strokeColor=#4A5568;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1928" y="714" width="259" height="120" as="geometry"/></mxCell><mxCell id="p1-S7" value="&lt;b&gt;S7 · Analítica y mapa de comprensión&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Logro por objetivo / indicador&lt;br&gt;Patrones de razonamiento y error&lt;br&gt;Agregación y anonimización por rol&lt;/font&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;size=0.04;fillColor=#FFFFFF;strokeColor=#4A5568;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="2213" y="714" width="259" height="120" as="geometry"/></mxCell><mxCell id="p1-E0" value="&lt;b&gt;E0 · Cuenta estudiante&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Creada por el centro o&lt;br&gt;por invitación del docente&lt;br&gt;Menor de edad: requiere&lt;br&gt;consentimiento vigente&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="218" y="972" width="259" height="120" as="geometry"/></mxCell><mxCell id="p1-E1" value="&lt;b&gt;E1 · Recibe y accede&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Ve instrucciones, tiempo,&lt;br&gt;política de ayuda y criterios&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1358" y="972" width="259" height="95" as="geometry"/></mxCell><mxCell id="p1-E2" value="&lt;b&gt;E2 · Resolver con tutor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Interpreta, elige estrategia, responde&lt;br&gt;y justifica (texto o voz)&lt;br&gt;Pide ayuda dentro de la política&lt;br&gt;Marca confianza por ítem · envía&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1643" y="972" width="259" height="130" as="geometry"/></mxCell><mxCell id="p1-E3" value="&lt;b&gt;E3 · Recibe retroalimentación&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Feedback por objetivo, no solo nota&lt;br&gt;Revisa su historial de razonamiento&lt;br&gt;Reflexión: ¿dónde necesité ayuda?&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1928" y="972" width="259" height="120" as="geometry"/></mxCell><mxCell id="p1-E4" value="&lt;b&gt;E4 · Próximos pasos&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Práctica sugerida&lt;br&gt;por objetivo débil&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;strokeWidth=2;fontColor=#102A43;fontSize=12;align=left;verticalAlign=top;spacing=8;arcSize=8;fontFamily=Helvetica;" 