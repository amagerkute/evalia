  <diagram id="evalia-flow-01" name="01 · Evaluación alineada al currículo">
    <mxGraphModel dx="1900" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="EVALIA · FLUJO 01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102A43;strokeColor=#102A43;fontColor=#FFFFFF;fontSize=26;fontStyle=1;align=left;spacingLeft=24;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1820" height="70" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Diseñar, ejecutar y mejorar una evaluación alineada al currículo oficial · Chile + Costa Rica" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#486581;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="65" y="102" width="1450" height="38" as="geometry"/></mxCell>
        <mxCell id="legend" value="PRIMER FLUJO DE PRODUCTO · El docente conserva el control editorial y pedagógico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#81E6D9;fontColor=#234E52;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1470" y="106" width="390" height="34" as="geometry"/></mxCell>

        <mxCell id="lane1" value="01 · CONTEXTO INSTITUCIONAL Y CURRICULAR" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#F0F7FF;swimlaneFillColor=#FFFFFF;strokeColor=#9FB3C8;fontColor=#102A43;fontSize=15;fontStyle=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="40" y="155" width="1590" height="295" as="geometry"/></mxCell>
        <mxCell id="lane2" value="02 · DISEÑO DOCENTE Y CONTROL DE CALIDAD" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#F3F0FF;swimlaneFillColor=#FFFFFF;strokeColor=#B8A9D9;fontColor=#102A43;fontSize=15;fontStyle=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="40" y="475" width="1590" height="300" as="geometry"/></mxCell>
        <mxCell id="lane3" value="03 · EXPERIENCIA DEL ESTUDIANTE" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#ECFDF3;swimlaneFillColor=#FFFFFF;strokeColor=#9AE6B4;fontColor=#102A43;fontSize=15;fontStyle=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1590" height="220" as="geometry"/></mxCell>
        <mxCell id="lane4" value="04 · RESULTADOS, VISTAS POR ROL Y MEJORA CONTINUA" style="swimlane;html=1;rounded=1;startSize=38;horizontal=1;fillColor=#FFF8E6;swimlaneFillColor=#FFFFFF;strokeColor=#F6C56B;fontColor=#102A43;fontSize=15;fontStyle=1;arcSize=5;" vertex="1" parent="1"><mxGeometry x="40" y="1045" width="1590" height="270" as="geometry"/></mxCell>

        <mxCell id="s1" value="&lt;b&gt;1 · Crear contexto educativo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Centro / cuenta individual&lt;br&gt;País · modalidad · calendario&lt;br&gt;Curso o grupo · responsables&lt;br&gt;Roles y permisos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E7CB1;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="85" y="225" width="300" height="170" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 · Resolver la ruta curricular&lt;/b&gt;&lt;br&gt;&lt;br&gt;País → oferta / marco vigente&lt;br&gt;Ciclo o nivel → año / curso&lt;br&gt;Asignatura / área → unidad / eje&lt;br&gt;Versión oficial + fecha de vigencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E7CB1;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="445" y="225" width="330" height="170" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 · Seleccionar intención de aprendizaje&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Chile:&lt;/b&gt; OA / OAT → eje → indicadores sugeridos → conocimientos, habilidades y actitudes.&lt;br&gt;&lt;br&gt;&lt;b&gt;Costa Rica:&lt;/b&gt; programa específico → unidad / eje → aprendizajes esperados, habilidades o resultados → indicadores y saberes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3E7CB1;strokeWidth=2;fontColor=#102A43;fontSize=13;align=left;verticalAlign=top;spacing=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="205" width="455" height="210" as="geometry"/></mxCell>
        <mxCell id="adapter" value="&lt;b&gt;REGLA DE ARQUITECTURA&lt;/b&gt;&lt;br&gt;Un modelo canónico común + adaptadores por país y por programa. No forzar equivalencias entre OA chilenos y aprendizajes / habilidades costarricenses." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF8FF;strokeColor=#63B3ED;fontColor=#1A365D;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=10;dashed=1;" vertex="1" parent="1"><mxGeometry x="1330" y="220" width="260" height="175" as="geometry"/></mxCell>

        <mxCell id="s4" value="&lt;b&gt;4 · Construir blueprint&lt;/b&gt;&lt;br&gt;&lt;br&gt;Propósito: diagnóstico / formativo / sumativo&lt;br&gt;Evidencias observables y criterios&lt;br&gt;Peso por objetivo y dificultad&lt;br&gt;Tipos de ítem, tiempo y ajustes&lt;br&gt;Fuentes verificables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="85" y="540" width="320" height="185" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;5 · Configurar tutor socrático&lt;/b&gt;&lt;br&gt;&lt;br&gt;Activar por pregunta&lt;br&gt;Niveles de ayuda 0–3&lt;br&gt;Preguntas guía · pistas · ejemplo parcial&lt;br&gt;Material permitido&lt;br&gt;Límites: nunca revelar la respuesta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="455" y="540" width="330" height="185" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;6 · Generar borrador con IA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Preguntas + claves&lt;br&gt;Rúbrica y criterios&lt;br&gt;Retroalimentación prevista&lt;br&gt;Trazabilidad: cada ítem ↔ objetivo ↔ evidencia ↔ fuente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#805AD5;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="835" y="540" width="330" height="185" as="geometry"/></mxCell>
        <mxCell id="gate" value="¿Cumple alineación,&lt;br&gt;calidad, accesibilidad&lt;br&gt;y política de ayuda?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEFCBF;strokeColor=#D69E2E;strokeWidth=2;fontColor=#744210;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1205" y="545" width="185" height="175" as="geometry"/></mxCell>
        <mxCell id="publish" value="&lt;b&gt;APROBAR Y PUBLICAR&lt;/b&gt;&lt;br&gt;&lt;br&gt;Asignar a grupo / estudiante&lt;br&gt;Ventana y condiciones&lt;br&gt;Consentimiento si aplica&lt;br&gt;Versión inmutable publicada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6FFFA;strokeColor=#319795;strokeWidth=2;fontColor=#234E52;fontSize=13;align=center;verticalAlign=middle;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1430" y="550" width="165" height="165" as="geometry"/></mxCell>

        <mxCell id="student" value="&lt;b&gt;7 · Resolver y explicar&lt;/b&gt;&lt;br&gt;&lt;br&gt;El estudiante interpreta, elige estrategia, intenta y justifica. Puede pedir ayuda dentro de la política definida." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="130" y="855" width="390" height="120" as="geometry"/></mxCell>
        <mxCell id="tutor" value="&lt;b&gt;8 · Tutor guía, no sustituye&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pregunta → pista gradual → comprobación → reflexión. Se adapta al tipo de ítem y al nivel de ayuda autorizado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="620" y="855" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="trace" value="&lt;b&gt;9 · Registrar evidencia de proceso&lt;/b&gt;&lt;br&gt;&lt;br&gt;Respuesta · tiempo · intentos · pistas&lt;br&gt;fuentes · revisiones · confianza&lt;br&gt;clasificación de errores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#38A169;strokeWidth=2;fontColor=#102A43;fontSize=14;align=left;verticalAlign=middle;spacing=14;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1120" y="855" width="400" height="120" as="geometry"/></mxCell>

        <mxCell id="teacherView" value="&lt;b&gt;DOCENTE / TUTOR&lt;/b&gt;&lt;br&gt;Logro por objetivo, razonamiento, errores, dependencia de pistas y acciones de reenseñanza." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#D69E2E;fontColor=#102A43;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="85" y="1115" width="330" height="125" as="geometry"/></mxCell>
        <mxCell id="studentView" value="&lt;b&gt;ESTUDIANTE&lt;/b&gt;&lt;br&gt;Feedback accionable, historial de razonamiento, próximos pasos y reflexión metacognitiva." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#D69E2E;fontColor=#102A43;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="465" y="1115" width="330" height="125" as="geometry"/></mxCell>
        <mxCell id="guardianView" value="&lt;b&gt;APODERADO / RESPONSABLE&lt;/b&gt;&lt;br&gt;Resumen comprensible de progreso, hábitos y apoyos sugeridos; sin exponer conversaciones sensibles por defecto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#D69E2E;fontColor=#102A43;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="845" y="1115" width="350" height="125" as="geometry"/></mxCell>
        <mxCell id="institutionView" value="&lt;b&gt;CENTRO EDUCACIONAL&lt;/b&gt;&lt;br&gt;Patrones agregados por curso, cohorte y objetivo; cobertura curricular y alertas. Sin decisiones automatizadas de alto impacto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDF5;strokeColor=#D69E2E;fontColor=#102A43;fontSize=13;align=left;verticalAlign=middle;spacing=12;arcSize=10;" vertex="1" parent="1"><mxGeometry x="1245" y="1115" width="345" height="125" as="geometry"/></mxCell>
        <mxCell id="loop" value="Los resultados actualizan el mapa de comprensión y alimentan la próxima planificación, actividad o evaluación." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFAF0;strokeColor=#ED8936;fontColor=#7B341E;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=10;arcSize=10;" vertex="1" parent="1"><mxGeometry x="485" y="1250" width="720" height="42" as="geometry"/></mxCell>

        <mxCell id="governance" value="&lt;b&gt;GOBERNANZA TRANSVERSAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;Identidad y roles&lt;br&gt;&lt;br&gt;Edad y consentimiento&lt;br&gt;&lt;br&gt;Privacidad por diseño&lt;br&gt;&lt;br&gt;Retención y exportación&lt;br&gt;&lt;br&gt;Auditoría y versionado&lt;br&gt;&lt;br&gt;Accesibilidad e inclusión&lt;br&gt;&lt;br&gt;Anonimización para investigación&lt;br&gt;&lt;br&gt;Supervisión humana" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#718096;strokeWidth=2;fontColor=#2D3748;fontSize=13;align=center;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1660" y="155" width="200" height="1160" as="geometry"/></mxCell>

